{
  "name": "sarexstudio-launcher",
  "productName": "Sarex Studio Launcher",
  "version": "2.0.0",
  "description": "Launcher de Sarex Studio: Minecraft 1.21.1 con Fabric y mods en un clic",
  "main": "src/main.js",
  "author": "Sarex Studio",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "minecraft-launcher-core": "^3.18.2",
    "msmc": "^5.0.5"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "studio.sarex.launcher",
    "productName": "Sarex Studio Launcher",
    "artifactName": "SarexStudioLauncher-Setup-${version}.${ext}",
    "files": ["src/**/*", "assets/**/*", "config.json", "manifest.local.json", "package.json"],
    "win": { "icon": "assets/icon.ico", "target": "nsis" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "shortcutName": "Sarex Studio Launcher" }
  }
}
